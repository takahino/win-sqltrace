root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows PowerShell 5.1 は BOM のない UTF-8 を ANSI として読み、日本語が化ける。
[*.{ps1,psm1}]
charset = utf-8-bom
end_of_line = crlf

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
